{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "build": {
    "content": [
      {
        "files": [ "**/*.{md,yml}" ],
        "exclude": [ "_site/**", "obj/**" ]
      }
    ],
    "resource": [
      {
        "files": [ "**/images/**", "**/media/**", "codesnippet/**" ],
        "exclude": [ "_site/**", "obj/**" ]
      }
    ],
    "globalMetadata": {
      "_appTitle": "Learning Notes",
      "_appName": "Learning Notes",
      "pdf": true
    },
    "output": "_site",
    "template": [
      "modern",
      "default",
      "template"
    ]
  }
}